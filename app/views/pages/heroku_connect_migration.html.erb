<% content_for :title, "Pipebird.io | Heroku Connect Migration" %>
<% content_for :head do %>
  <meta name="description" content="Heroku Connect migration planning page with placeholder migration packages and execution phases." />
<% end %>

<main class="migration-page">
  <header class="hero">
    <%= render "site_nav", current_page: :heroku_connect_migration %>

    <div class="hero-content">
      <p class="eyebrow">Migration</p>
      <h1>Heroku Connect migration without downtime surprises.</h1>
      <p class="hero-copy">
        Move from Heroku Connect to Pipebird with phased cutover, side-by-side validation, and placeholder
        migration package detail you can finalize with your team.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="mailto:contact@pipebird.io">Book a demo</a>
        <a class="button secondary" href="/contact-us">Get started</a>
      </div>
    </div>
  </header>

  <section class="section">
    <p class="eyebrow">Migration phases</p>
    <h2>Structured rollout from discovery to production cutover</h2>
    <div class="scenario-grid">
      <article>
        <h3>1. Discovery</h3>
        <p>Placeholder inventory of current mappings, tables, and sync frequency requirements.</p>
      </article>
      <article>
        <h3>2. Parallel run</h3>
        <p>Placeholder dual-run period with drift detection and reconciliation checks.</p>
      </article>
      <article>
        <h3>3. Cutover</h3>
        <p>Placeholder runbook for final switchover, rollback guardrails, and support coverage.</p>
      </article>
    </div>
  </section>

  <section class="section detail-stack">
    <div class="section-copy">
      <p class="eyebrow">What is included</p>
      <h2>Migration package placeholders</h2>
      <ul class="bullet-list">
        <li>Placeholder schema and mapping translation.</li>
        <li>Placeholder data parity checks across key objects.</li>
        <li>Placeholder performance benchmarking and tuning.</li>
      </ul>
    </div>

    <div class="section-copy">
      <p class="eyebrow">Common risks we mitigate</p>
      <div class="feature-grid">
        <article>
          <h3>Duplicate writes</h3>
          <p>Placeholder guardrails for avoiding duplicate record updates during overlap windows.</p>
        </article>
        <article>
          <h3>Identity mismatches</h3>
          <p>Placeholder merge and matching strategy for account/contact resolution.</p>
        </article>
        <article>
          <h3>Backfill pressure</h3>
          <p>Placeholder throttling and queue controls for large historical sync jobs.</p>
        </article>
        <article>
          <h3>Operational visibility</h3>
          <p>Placeholder dashboarding for sync health, lag, failures, and replay workflow.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section pricing-table-wrap">
    <p class="eyebrow">Timeline (placeholder)</p>
    <h2>Example migration plan</h2>
    <div class="pricing-table-scroller">
      <table class="pricing-table">
        <thead>
          <tr>
            <th>Week</th>
            <th>Focus</th>
            <th>Output</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Week 1</td>
            <td>Discovery and mapping review</td>
            <td>Placeholder migration blueprint</td>
          </tr>
          <tr>
            <td>Week 2</td>
            <td>Parallel sync validation</td>
            <td>Placeholder parity report</td>
          </tr>
          <tr>
            <td>Week 3</td>
            <td>Cutover and monitoring</td>
            <td>Placeholder go-live checklist</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="section callout">
    <p class="eyebrow">Plan your migration</p>
    <h2>Tell us your current Heroku Connect footprint and target cutover date.</h2>
    <p>We will return a tailored migration sequence with final scope replacing placeholders.</p>
    <a class="button primary" href="/contact-us">Request migration plan</a>
  </section>
</main>
